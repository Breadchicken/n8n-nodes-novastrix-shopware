		{
			"parameters": {
				"jsCode": "// Checks each sheet row and normalizes the values for Shopware.\nconst config = $('Configuration').first().json;\nconst toNumber = (value) => Number(String(value ?? '').replace(',', '.').trim());\n\nreturn $input.all().map((item) => {\n  const row = item.json;\n  const product = {\n    row_number: row.row_number,\n    productNumber: String(row.product_number ?? '').trim(),\n    name: String(row.name ?? '').trim(),\n    price: toNumber(row.price),\n    stock: Math.trunc(toNumber(row.stock || 0)),\n    taxRate: String(row.tax_rate || config.defaultTaxRate).trim(),\n    manufacturer: String(row.manufacturer ?? '').trim(),\n    category: String(row.category ?? '').trim(),\n    description: String(row.description ?? ''),\n    active: !['no', 'false', '0'].includes(String(row.active ?? 'yes').trim().toLowerCase()),\n  };\n  const problems = [];\n  if (!product.productNumber) problems.push('product_number is empty');\n  if (!product.name) problems.push('name is empty');\n  if (!(product.price > 0)) problems.push('price must be a number above 0');\n  if (!Number.isFinite(product.stock) || product.stock < 0) problems.push('stock must be 0 or more');\n  return { json: { ...product, valid: problems.length === 0, problem: problems.join('; ') } };\n});\n"
			},

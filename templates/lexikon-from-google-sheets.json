			"name": "Get Existing Categories",
			"type": "n8n-nodes-novastrix-shopware.shopware",
			"typeVersion": 1,
			"position": [
				1280,
				-100
			],
			"credentials": {
				"shopwareAdminApi": {
					"name": "Shopware account"
				}
			},
			"executeOnce": true,
			"alwaysOutputData": true
		},
		{
			"parameters": {
				"jsCode": "// Marks the first row of each category that does not exist in Shopware yet.\nconst existing = new Set(\n  $input.all().map((item) => String(item.json.name ?? '').trim().toLowerCase()).filter(Boolean),\n);\nreturn $('Is Row Valid?').all().map((item) => {\n  const key = item.json.category.toLowerCase();\n  const createCategory = key !== '' && !existing.has(key);\n  if (createCategory) existing.add(key);\n  return { json: { ...item.json, createCategory } };\n});\n"
			},

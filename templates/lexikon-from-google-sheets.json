		{
			"parameters": {
				"jsCode": "// Checks each sheet row and prepares the values for the Lexikon.\nreturn $input.all().map((item) => {\n  const row = item.json;\n  const entry = {\n    row_number: row.row_number,\n    term: String(row.term ?? '').trim(),\n    shortDefinition: String(row.short_definition ?? '').trim(),\n    description: String(row.description ?? ''),\n    synonyms: String(row.synonyms ?? '').trim(),\n    category: String(row.category ?? '').trim(),\n  };\n  const problems = [];\n  if (!entry.term) problems.push('term is empty');\n  if (entry.shortDefinition.length > 255) problems.push('short_definition is longer than 255 characters');\n  return { json: { ...entry, valid: problems.length === 0, problem: problems.join('; ') } };\n});\n"
			},
			"id": "ffdfe841-924b-5cd3-9d10-8537bfc5135e",
			"name": "Validate Rows",
			"type": "n8n-nodes-base.code",

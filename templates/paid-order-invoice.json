				"emailType": "text",
				"message": "=Hello {{ $('When Payment Is Marked Paid').item.json.order.customer.firstName }},\n\nthank you for your payment. Your invoice {{ $json.documentNumber }} for order {{ $json.orderNumber }} is attached.\n\nKind regards",
				"options": {
					"appendAttribution": false,
					"attachmentsUi": {
						"attachmentsBinary": [
							{
								"property": "data"
							}
						]

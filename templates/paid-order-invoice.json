					"mode": "name",
					"value": "={{ $('Configuration').first().json.slackChannel }}"
				},
				"text": "=Order {{ $json.orderNumber }} is paid: {{ $('When Payment Is Marked Paid').item.json.order.amountTotal }} {{ $('When Payment Is Marked Paid').item.json.order.currency }} from {{ $('When Payment Is Marked Paid').item.json.order.customer.firstName }} {{ $('When Payment Is Marked Paid').item.json.order.customer.lastName }}. Invoice {{ $json.documentNumber }} was sent.",

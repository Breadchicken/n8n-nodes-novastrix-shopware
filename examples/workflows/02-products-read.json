			"position": [0, 0],
			"parameters": {}
		},
		{
			"id": "note",
			"name": "About",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-40, -300],
			"parameters": {
				"content": "## Read products\n1. **Get Many**: 10 active main products, newest changes first\n2. **Get**: the first one again, by ID, with manufacturer and categories\n\nRead-only.",
				"width": 640,
				"height": 240
			}
		},
		{
			"id": "n0",
			"name": "Get Products",
			"type": "n8n-nodes-novastrix-shopware.shopware",
			"typeVersion": 1,
			"position": [260, 0],

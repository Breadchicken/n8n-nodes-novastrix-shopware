				"options": {
					"sort": {
						"items": [
							{
								"field": "updatedAt",
								"order": "DESC"
							}
						]
					}
				}
			},
			"credentials": {
				"shopwareAdminApi": {
					"id": "nvsQuickstartCr1",
					"name": "Shopware (Quickstart)"
				}
			}
		},
		{
			"id": "n1",
			"name": "Get First Product",
			"type": "n8n-nodes-novastrix-shopware.shopware",
			"typeVersion": 1,
			"position": [520, 0],
			"parameters": {
				"resource": "product",
				"operation": "get",
				"product": {
					"__rl": true,
					"mode": "id",
					"value": "={{ $json.id }}"
				},
				"options": {
					"associations": ["manufacturer", "categories"]

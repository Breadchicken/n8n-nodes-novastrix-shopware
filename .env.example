# Read by `docker compose` and by the quickstart inside the n8n container.

# Your user and group ID (`id -u`, `id -g`), so files the dev container writes keep your owner.
UID=1000
GID=1000

# Shopware credential, imported on every start of the n8n container.
# Shopware admin: Settings > System > Integrations > Add integration
# localhost is rewritten to host.docker.internal, so a shop on the host is reachable.
SHOPWARE_URL=http://localhost:8080
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=

# Optional
# N8N_VERSION=stable            # n8nio/n8n image tag, e.g. 2.48.7, next, v3-nightly
# N8N_BIND_ADDRESS=127.0.0.1    # host address n8n is published on (never 0.0.0.0)
# N8N_PORT=5678
# N8N_WEBHOOK_URL=http://localhost:5678/   # public n8n URL, used for Shopware Trigger webhooks
